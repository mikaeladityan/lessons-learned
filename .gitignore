# Local planning, session memory, and eval run output. Not part of the published skill.
.design/
.remember/
.workspace/

# Dependencies and package-manager logs (the project has none, but contributors may run npm)
node_modules/
npm-debug.log*

# Editors and OS files
.DS_Store
Thumbs.db
